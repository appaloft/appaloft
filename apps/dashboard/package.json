{
  "name": "@appaloft/dashboard",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "bun run check",
    "lint": "oxlint .",
    "check:design": "vitest --run test/design-governance.test.ts",
    "check:bundle": "bun run build && bun run scripts/check-bundle-budget.ts",
    "test": "vitest --run --exclude 'test/e2e-dashboard/**'",
    "test:unit": "vitest --run --exclude 'test/e2e-dashboard/**'",
    "test:e2e": "bun run test:e2e:webview",
    "test:e2e:webview": "bun run build && bun test --timeout=60000 test/e2e-dashboard/foundation.webview.test.ts"
  },
  "devDependencies": {
    "@appaloft/application": "workspace:*",
    "@appaloft/contracts": "workspace:*",
    "@appaloft/core": "workspace:*",
    "@appaloft/design": "workspace:*",
    "@appaloft/i18n": "workspace:*",
    "@appaloft/orpc": "workspace:*",
    "@appaloft/ui": "workspace:*",
    "@lucide/svelte": "^1.21.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.68.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "elysia": "^1.4.29",
    "shadcn-svelte": "^1.3.0",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
