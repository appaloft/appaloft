{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    // `astro/tsconfigs/strict` doesn't set `types`, so without this,
    // `bun:test` (used by `src/lib/locale-preference.test.ts`) isn't
    // resolvable — `bun-types` isn't under `node_modules/@types/`, so
    // TypeScript won't auto-include it.
    "types": ["bun-types"],
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
