{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "**/.git/**",
    "**/.turbo/**",
    "**/.astro/**",
    "**/.svelte-kit/**",
    "**/.next/**",
    "**/node_modules/**",
    "**/build/**",
    "**/dist/**",
    "**/coverage/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "**/runtime/**",
    "**/.appaloft/**",
    "**/.tmp/**",
    "**/*.svelte",
    "**/*.astro",
    "apps/desktop/src-tauri/**",
    "apps/workspace-control-tui/**",
    "bun.lock",
    "Cargo.lock"
  ],
  "sortImports": false,
  "sortPackageJson": false
}
